# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change_me_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host PostgreSQL (accessible from Docker via host-gateway)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=server_iq
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# Host ports (must be free — check with ss -tulnp)
BACKEND_PORT=8100
FRONTEND_PORT=8101

# CORS — set to your domain in production
CORS_ORIGINS=["https://server.exzellenzschmiede.de"]

# VPS Console — SSH from container to host (host.docker.internal:22)
# Encode the private key: base64 -w0 ~/.ssh/id_ed25519
CONSOLE_SSH_HOST=host.docker.internal
CONSOLE_SSH_PORT=22
CONSOLE_SSH_USER=deploy
CONSOLE_SSH_KEY_B64=
